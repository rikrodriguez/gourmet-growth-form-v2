# Template only. Set real values as runtime secrets in the staging resource.
# Leave secrets out of Git, build arguments, screenshots and logs.
OFFICE_STAGING_ORIGIN=
OFFICE_STAGING_USERNAME=
OFFICE_STAGING_PASSWORD=
OFFICE_STAGING_DB_PASSWORD=
# A comma-separated list of the actual private proxy addresses/CIDRs.
# Compose adds 127.0.0.1/32 for its authenticated local health check.
OFFICE_STAGING_TRUSTED_PROXY_CIDRS=
# viewer is the initial cap; operator must be enabled explicitly.
OFFICE_STAGING_ROLE=viewer
