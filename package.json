{
  "name": "gourmet-growth-form-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node server.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "office:dev": "vite --config vite.office.config.ts",
    "office:up": "node scripts/office-dev.mjs",
    "office:build": "vite build --config vite.office.config.ts",
    "office:preview": "vite preview --config vite.office.config.ts",
    "office:api": "tsx src/office/backend/server.ts",
    "office:staging": "node --import tsx src/office/backend/staging-server.ts",
    "office:db": "node scripts/office-db.mjs",
    "test:office": "node --import tsx --test tests/office/*.test.ts",
    "test:operations": "node --test tests/operations/*.test.mjs",
    "test:office:e2e": "playwright test --config office-playwright.config.ts",
    "test:staging:e2e": "playwright test --config staging-playwright.config.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.4",
    "fastify": "5.12.5",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
