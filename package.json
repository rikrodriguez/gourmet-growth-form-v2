{
  "name": "gourmet-growth-form-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node server.mjs",
    "context:prepare": "node scripts/prepare-reservation-context.mjs",
    "context:fixture": "node scripts/generate-reviewed-fixture.mjs",
    "test:context": "node --test tests/context/*.test.mjs",
    "test:voice": "node extensions/voice-context/test.mjs",
    "test:evidence": "node --test extensions/voice-context/evidence.test.mjs",
    "test:prototype": "npm run test:context && npm run test:evidence && npm run test:voice",
    "test:generator:external": "node scripts/test-external-generator-fixture.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fastify/static": "10.1.4",
    "fastify": "5.12.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
