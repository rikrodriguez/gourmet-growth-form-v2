+    /** @param array<string,mixed> $checkout */
+    private function startVersionedCheckoutV1(Request $request, array $checkout, string $token): Response
+    {
+        if (!$this->versionedCheckoutProviderEnabled()) { return Response::json(['status' => 'provider_disabled'], 503); }
+        if (in_array((string) $checkout['status'], ['INITIAL_PAID', 'RESERVATION_PAID', 'FULLY_PAID'], true)) {
+            return Response::redirect($this->linkUrl($token) . '/status');
+        }
+        $service = new PaymentAgreementService($this->pdo());
+        $derived = $service->checkoutConditionsForAgreementV1((int) $checkout['id']);
+        if (!Csrf::validate($request->post['csrf_token'] ?? '', $request->cookies['gp_checkout_csrf'] ?? '')
+            || ($request->post['consent'] ?? '') !== 'yes' || ($request->post['conditions_digest'] ?? '') !== $derived->digest) {
+            return $this->versionedCheckoutPageV1($checkout, $token, 'Please review and accept this agreement before continuing.');
+        }
+        try {
+            $this->assertPayPalCheckoutAllowed();
+            $nowMs = $this->milliseconds($this->now());
+            $derived->assertCurrent($nowMs);
+            $service->recordCheckoutConsentsV1($checkout, Secrets::privacyHash($request->ipAddress, $this->config->appKey), $request->userAgent);
