+                $this->linkUrl($token) . '/paypal/return', $this->linkUrl($token), $nowMs);
+            return is_string($result['approvalUrl'] ?? null) && $result['approvalUrl'] !== ''
+                ? Response::redirect($result['approvalUrl']) : Response::redirect($this->linkUrl($token) . '/status');
+        } catch (\Throwable $exception) {
+            $this->logger->log('warning', 'checkout.versioned_start_unavailable', ['exception_class' => $exception::class]);
+            return $this->versionedCheckoutPageV1($checkout, $token, 'We could not start PayPal securely. Check payment status before retrying.');
+        }
+    }
