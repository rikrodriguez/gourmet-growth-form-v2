+                        'actor_id' => $command->authorization->actorId,
+                        'source_quote_version' => $command->operation->prepared->plan->sourceQuote->version,
+                    ]);
+                },
+            );
+            if (!is_array($receipt) || $receipt['agreementId'] !== ($agreement['agreement_uuid'] ?? null)) {
+                throw new \RuntimeException('Disabled agreement receipt was not recorded.');
+            }
+            $pdo->commit();
+            $transactionStarted = false;
+            return Response::json($receipt, 201);
+        } catch (\DomainException) {
+            if ($transactionStarted && $pdo->inTransaction()) { $pdo->rollBack(); }
+            return Response::json(['status' => 'invalid_request'], 422);
+        } catch (\Throwable $exception) {
+            if ($transactionStarted && $pdo->inTransaction()) { $pdo->rollBack(); }
+            $this->logger->log('error', 'internal.payment_draft_v2_failed', ['request_id' => $requestId, 'exception_class' => $exception::class]);
+            return Response::json(['status' => 'request_unavailable'], 503);
+        }
+    }
