+    private function internalCheckoutEmissionV1(Request $request, string $requestId): Response
+    {
+        if (!in_array(mb_strtolower((string) $this->paypalEnv()->get('INTERNAL_CHECKOUT_V1_ENABLED', 'false')), ['1', 'true'], true)
+            || !InternalApiAuthenticator::validBearer($request->headers['authorization'] ?? null, $this->internalApiSharedSecret())) {
+            return Response::json(['status' => 'not_found'], 404);
+        }
+        if ($request->method !== 'POST') { return Response::json(['status' => 'method_not_allowed'], 405)->withHeaders(['Allow' => 'POST']); }
+        if (preg_match('/\Aapplication\/json(?:\s*;[^\r\n]*)?\z/i', $request->headers['content-type'] ?? '') !== 1) {
+            return Response::json(['status' => 'invalid_request'], 415);
+        }
+        try {
+            $now = $this->now();
+            $command = InternalCheckoutEmissionV1::fromJson($request->rawBody, $this->milliseconds($now));
+            if (($request->headers['idempotency-key'] ?? '') !== $command->idempotencyKey()) {
+                return Response::json(['status' => 'invalid_request'], 400);
+            }
+            if ($this->config->isProduction() || $command->authorization->scope->mode !== 'test') {
+                return Response::json(['status' => 'checkout_execution_disabled'], 503);
+            }
+            $cipher = $this->paymentLinkReplayCipher();
+            $result = (new PaymentAgreementService($this->pdo()))->issueCheckoutV1($command, $now, $this->config->appUrl, $cipher,
+                $request->path === '/internal/payment-checkouts/v1/reconcile');
+            if ($result === null) { return Response::json(['status' => 'not_found'], 404); }
+            return Response::json($result['receipt'], $result['replayed'] ? 200 : 201);
+        } catch (\DomainException $exception) {
+            $code = $exception->getMessage();
+            if ($code === 'CHECKOUT_SOURCE_NOT_FOUND') { return Response::json(['status' => 'not_found'], 404); }
+            if (in_array($code, ['CHECKOUT_SOURCE_CHANGED', 'CHECKOUT_IDEMPOTENCY_CONFLICT'], true)) {
+                return Response::json(['status' => 'source_conflict'], 409);
+            }
+            return Response::json(['status' => 'invalid_request'], 422);
+        } catch (\PDOException $exception) {
+            $native = (int) ($exception->errorInfo[1] ?? 0);
+            if (($this->config->ledgerDriver === 'sqlite' && in_array($native & 255, [5, 6], true))
+                || ($this->config->ledgerDriver === 'mysql' && in_array($native, [1205, 1213], true))) {
+                return Response::json(['status' => 'issuance_in_progress'], 409);
+            }
+            $this->logger->log('error', 'internal.payment_checkout_v1_ledger_failed', ['request_id' => $requestId, 'exception_class' => $exception::class]);
+            return Response::json(['status' => 'request_unavailable'], 503);
+        } catch (\Throwable $exception) {
+            $this->logger->log('error', 'internal.payment_checkout_v1_failed', ['request_id' => $requestId, 'exception_class' => $exception::class]);
+            return Response::json(['status' => 'request_unavailable'], 503);
+        }
+    }
