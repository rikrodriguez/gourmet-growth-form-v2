{
  "manifest_version": 3,
  "name": "Gourmet · contexto de Voice",
  "description": "Captura manual y local del texto visible de una conversación abierta. Prototipo sin envíos ni pagos.",
  "version": "0.1.0",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "Preparar contexto de Voice",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; style-src 'self'"
  }
}
